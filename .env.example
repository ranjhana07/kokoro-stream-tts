KOKORO_ENGINE=sine
KOKORO_MODEL_PATH=models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=models/voices-v1.0.bin
KOKORO_VOCAB_PATH=models/config.json
KOKORO_PROVIDERS=CPUExecutionProvider
KOKORO_INTRA_OP_THREADS=2
SAMPLE_RATE=24000
DEFAULT_VOICE=af_heart
FIRST_CHUNK_CHARS=60
MAX_CHUNK_CHARS=220
PREFETCH_DEPTH=3
PREFETCH_WORKERS=4
CROSSFADE_MS=60
TRIM_SILENCE=1
CHUNK_CACHE_MB=32
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_REQUEST_TOPIC=tts.jobs.requests
KAFKA_STATUS_TOPIC=tts.jobs.status
KAFKA_DEAD_LETTER_TOPIC=tts.jobs.dead
KAFKA_GROUP=tts-workers
JOB_MAX_ATTEMPTS=3
WORKER_METRICS_PORT=9100
OUTPUT_DIR=output
JOB_OUTPUT=output/audio
MAX_TEXT_CHARS=5000
MAX_JOB_TEXT_CHARS=200000
WARMUP=1
MAX_STREAMS=64
API_KEYS=
